# اطلاعات ورود به سامانه سوخت
PERSONNEL_CODE=
NATIONAL_CODE=

# اطلاعات تحویل‌گیرنده سوخت
RECIPIENT_FIRST_NAME=
RECIPIENT_LAST_NAME=
RECIPIENT_NATIONAL_CODE=

# میزان سوخت درخواستی: 20 یا 40 یا 60
FUEL_AMOUNT=60

# فیلتر اختیاری (خالی = هر روز یا جایگاه موجود)
# مثال روز: 2026-11-21,2026-11-22
PREFERRED_DAYS=
# مثال جایگاه: الماس نودژ,دوراندیش
PREFERRED_STATIONS=

# فاصله هر بار بررسی به ثانیه
POLL_INTERVAL_SECONDS=3

# نمایش مرورگر (false = مرورگر باز و قابل مشاهده، true = پس‌زمینه)
HEADLESS=false

# حالت تست: true یعنی فرم را پر می‌کند ولی دکمه ثبت نهایی را نمی‌زند
DRY_RUN=true

# اطلاع‌رسانی تلگرام (اختیاری)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
